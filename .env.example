# Resend API key for the contact form. Without it, the form validates input
# but returns a "not configured yet" message instead of sending mail.
RESEND_API_KEY=

# Optional: the verified "from" address/name Resend sends as.
# Defaults to Resend's shared sandbox sender (testing only) if unset.
CONTACT_FROM_EMAIL="Portfolio <hello@yourdomain.com>"
